generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
}

model User {
  id             Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  password       String?
  empCode        String?   @unique
  role           Role      @default(EMPLOYEE)
  department     String?
  deptHeadId     Int? // User ID of department head (self-relation)
  joinDate       DateTime? // Service start date for eligibility calculations (Policy 6.18)
  retirementDate DateTime? // Expected retirement date for study leave validation (Policy 6.25.a)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  leaves               LeaveRequest[]
  balances             Balance[]
  approvals            Approval[]           @relation("ApprovalApprover")
  deptHead             User?                @relation("HeadToMembers", fields: [deptHeadId], references: [id])
  teamMembers          User[]               @relation("HeadToMembers")
  encashmentRequests   EncashmentRequest[]
  encashmentApprovals  EncashmentRequest[]  @relation("EncashmentApprover")
  encashmentProcessed  EncashmentRequest[]  @relation("EncashmentProcessor")
  balanceAdjustments   BalanceAdjustment[]  @relation("BalanceAdjustments")
  adjustmentsMade      BalanceAdjustment[]  @relation("AdjustmentsMade")
  delegationsDelegated ApprovalDelegation[] @relation("DelegationsDelegated")
  delegationsReceived  ApprovalDelegation[] @relation("DelegationsReceived")
  preferences          UserPreferences?
  leaveTemplates       LeaveTemplate[]
  policyVersions       PolicyVersion[]

  // Enhanced Profile Relations
  profile           UserProfile?
  emergencyContacts EmergencyContact[]
  bankDetails       BankDetails?
  documents         UserDocument[]

  // HRIS Integration Relations
  hrisSyncs             HRISSync[]     @relation("HRISSyncs")
  hrisConflictsEmployee HRISConflict[] @relation("HRISConflictsEmployee")
  hrisConflictsResolver HRISConflict[] @relation("HRISConflictsResolver")

  // Scheduled Reports Relations
  scheduledReports ScheduledReport[] @relation("ReportCreator")

  // Calendar Integration Relations
  calendarConfigs CalendarConfig[]

  // Webhook Relations
  webhooks Webhook[]

  @@index([deptHeadId])
}

model LeaveRequest {
  id                    Int                    @id @default(autoincrement())
  requesterId           Int
  type                  LeaveType
  startDate             DateTime
  endDate               DateTime
  workingDays           Int
  reason                String
  needsCertificate      Boolean                @default(false)
  certificateUrl        String?
  status                LeaveStatus            @default(DRAFT)
  policyVersion         String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  fitnessCertificateUrl String?
  isModified            Boolean                @default(false)
  incidentDate          DateTime?
  isExtension           Boolean                @default(false)
  parentLeaveId         Int?
  payCalculation        Json?
  studyLeaveDocuments   Json?
  cancellationReason    String?
  isCancellationRequest Boolean                @default(false)
  isPartialCancellation Boolean                @default(false)
  originalEndDate       DateTime?
  approvals             Approval[]
  comments              LeaveComment[]
  parentLeave           LeaveRequest?          @relation("LeaveExtension", fields: [parentLeaveId], references: [id])
  extensions            LeaveRequest[]         @relation("LeaveExtension")
  requester             User                   @relation(fields: [requesterId], references: [id])
  versions              LeaveVersion[]
  calendarMappings      LeaveCalendarMapping[]

  @@index([requesterId, status])
  @@index([parentLeaveId])
  @@index([status, startDate])
  @@index([status, updatedAt])
  @@index([startDate, endDate, status])
  @@index([type, status, startDate])
}

model Approval {
  id         Int              @id @default(autoincrement())
  leaveId    Int
  step       Int
  approverId Int
  decision   ApprovalDecision @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  toRole     String?
  approver   User             @relation("ApprovalApprover", fields: [approverId], references: [id])
  leave      LeaveRequest     @relation(fields: [leaveId], references: [id])

  @@index([leaveId])
  @@index([approverId, decision])
  @@index([approverId, decidedAt])
}

model Balance {
  id      Int       @id @default(autoincrement())
  userId  Int
  type    LeaveType
  year    Int
  opening Int
  accrued Int
  used    Int       @default(0)
  closing Int
  user    User      @relation(fields: [userId], references: [id])

  @@unique([userId, type, year])
}

model Holiday {
  id         Int      @id @default(autoincrement())
  date       DateTime @unique
  name       String
  isOptional Boolean  @default(false)
}

model PolicyConfig {
  id         Int       @id @default(autoincrement())
  leaveType  LeaveType @unique
  maxDays    Int?
  minDays    Int?
  noticeDays Int?
  carryLimit Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorEmail  String
  action      String
  targetEmail String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model LeaveComment {
  id         Int          @id @default(autoincrement())
  leaveId    Int
  authorId   Int
  authorRole String
  comment    String
  createdAt  DateTime     @default(now())
  leave      LeaveRequest @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  @@index([leaveId])
}

model LeaveVersion {
  id            Int          @id @default(autoincrement())
  leaveId       Int
  version       Int
  data          Json
  createdAt     DateTime     @default(now())
  createdById   Int
  createdByRole String
  leave         LeaveRequest @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  @@index([leaveId])
  @@index([leaveId, version])
}

// EL Encashment Request (Policy 6.19.f)
// Employees can encash EL balance exceeding 10 days
model EncashmentRequest {
  id                Int              @id @default(autoincrement())
  userId            Int
  year              Int // Year of EL balance being encashed
  daysRequested     Int // Days employee wants to encash
  balanceAtRequest  Int // EL balance at time of request (for audit)
  reason            String? // Optional reason for encashment
  status            EncashmentStatus @default(PENDING)
  approvedBy        Int? // User ID of approver (typically CEO)
  approvedAt        DateTime?
  rejectionReason   String?
  paidAt            DateTime? // When payment was processed
  // Payment tracking fields
  paymentStatus     String? // PENDING, PROCESSING, PAID, FAILED
  paymentMethod     String? // BANK_TRANSFER, CHEQUE, CASH
  paymentReference  String? // Payment reference number/transaction ID
  paymentDate       DateTime? // Actual payment completion date
  paymentReceiptUrl String? // URL to payment receipt/proof
  processedBy       Int? // User ID who processed the payment (usually HR_HEAD or CEO)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user      User  @relation(fields: [userId], references: [id])
  approver  User? @relation("EncashmentApprover", fields: [approvedBy], references: [id])
  processor User? @relation("EncashmentProcessor", fields: [processedBy], references: [id])

  @@index([userId, status])
  @@index([status])
  @@index([paymentStatus])
}

model OrgSettings {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   Int? // User ID
}

// 2FA OTP (One-Time Password) Model
model OtpCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  email     String
  code      String // 6-digit code
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0) // Track verification attempts
  ipAddress String? // Track IP for security
  createdAt DateTime @default(now())

  @@index([email, verified])
  @@index([expiresAt])
  @@map("OtpCode")
}

// Real-time notification system
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int // Recipient user ID
  type      NotificationType
  title     String
  message   String
  link      String? // Optional link to related resource (e.g., /leaves/123)
  leaveId   Int? // Related leave request ID
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  expiresAt DateTime? // Optional expiry for time-sensitive notifications

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum Role {
  EMPLOYEE
  DEPT_HEAD
  HR_ADMIN
  HR_HEAD
  CEO
  SYSTEM_ADMIN
}

enum LeaveType {
  EARNED
  CASUAL
  MEDICAL
  EXTRAWITHPAY
  EXTRAWITHOUTPAY
  MATERNITY
  PATERNITY
  STUDY
  SPECIAL_DISABILITY
  QUARANTINE
  SPECIAL
}

enum LeaveStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  RETURNED
  CANCELLATION_REQUESTED
  RECALLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  FORWARDED
  PENDING
  RETURNED
}

enum EncashmentStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum NotificationType {
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_RETURNED
  LEAVE_FORWARDED
  LEAVE_CANCELLED
  LEAVE_CANCELLATION_REQUESTED
  LEAVE_APPROACHING
  APPROVAL_REQUIRED
  ENCASHMENT_APPROVED
  ENCASHMENT_REJECTED
  SYSTEM_ANNOUNCEMENT
  LEAVE_TYPE_CHANGED
}

enum ReportType {
  LEAVE_SUMMARY // Overall leave statistics
  LEAVE_BALANCE // Current balance status
  LEAVE_UTILIZATION // Utilization analysis
  ATTENDANCE_REPORT // Attendance patterns
  APPROVAL_TIMES // Approval efficiency
  DEPARTMENT_ANALYTICS // Department-wise breakdown
  EMPLOYEE_HISTORY // Individual employee leave history
  BURNOUT_RISK // Wellbeing and burnout analysis
  COST_ANALYSIS // Financial impact
  PATTERN_DETECTION // Abuse pattern detection
  FORECAST_REPORT // Future leave predictions
  COMPLIANCE_AUDIT // Policy compliance check
}

enum ReportFormat {
  PDF
  EXCEL
  CSV
  JSON
}

enum ReportFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

// Balance Adjustment Model
// For manual balance corrections by SYSTEM_ADMIN
model BalanceAdjustment {
  id              Int       @id @default(autoincrement())
  userId          Int // Employee whose balance is being adjusted
  leaveType       LeaveType
  year            Int
  amount          Int // Positive for credit, negative for debit
  reason          String // Required explanation for audit trail
  previousBalance Int // Balance before adjustment
  newBalance      Int // Balance after adjustment
  adjustedBy      Int // SYSTEM_ADMIN who made the adjustment
  createdAt       DateTime  @default(now())

  user           User @relation("BalanceAdjustments", fields: [userId], references: [id])
  adjustedByUser User @relation("AdjustmentsMade", fields: [adjustedBy], references: [id])

  @@index([userId, leaveType, year])
  @@index([adjustedBy])
  @@index([createdAt])
}

// Approval Delegation Model
// Allows approvers to delegate their approval authority temporarily
model ApprovalDelegation {
  id          Int      @id @default(autoincrement())
  delegatorId Int // User who is delegating (original approver)
  delegateId  Int // User who will act as delegate
  startDate   DateTime // When delegation starts
  endDate     DateTime // When delegation ends
  isActive    Boolean  @default(true) // Can be manually revoked
  reason      String? // Optional reason for delegation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  delegator User @relation("DelegationsDelegated", fields: [delegatorId], references: [id])
  delegate  User @relation("DelegationsReceived", fields: [delegateId], references: [id])

  @@index([delegatorId, isActive])
  @@index([delegateId, isActive])
  @@index([startDate, endDate])
}

// User Dashboard Preferences
model UserPreferences {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  dashboardLayout Json? // Widget arrangement and visibility
  theme           String?  @default("system") // light, dark, system
  notifications   Json? // Notification preferences
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// HRIS Integration - Sync tracking
model HRISSync {
  id            Int       @id @default(autoincrement())
  provider      String // "csv", "excel", "api"
  status        String // "pending", "running", "completed", "failed"
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  recordsTotal  Int
  recordsSynced Int       @default(0)
  recordsFailed Int       @default(0)
  errors        Json?
  createdBy     Int

  user      User           @relation("HRISSyncs", fields: [createdBy], references: [id])
  conflicts HRISConflict[]

  @@index([status, startedAt])
  @@index([createdBy])
}

// HRIS Integration - Conflict resolution
model HRISConflict {
  id           Int       @id @default(autoincrement())
  syncId       Int
  employeeId   Int?
  conflictType String // "duplicate", "mismatch", "missing"
  hrisData     Json // Data from HRIS
  systemData   Json // Current system data
  resolution   String? // "keep_hris", "keep_system", "merge", "skip"
  resolvedBy   Int?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  sync     HRISSync @relation(fields: [syncId], references: [id], onDelete: Cascade)
  employee User?    @relation("HRISConflictsEmployee", fields: [employeeId], references: [id])
  resolver User?    @relation("HRISConflictsResolver", fields: [resolvedBy], references: [id])

  @@index([syncId, resolution])
  @@index([employeeId])
}

// Leave Templates for quick application
model LeaveTemplate {
  id        Int       @id @default(autoincrement())
  userId    Int
  name      String // Template name (e.g., "Annual Vacation")
  leaveType LeaveType
  duration  Int // Typical duration in days
  reason    String // Pre-filled reason
  isShared  Boolean   @default(false) // Can be shared with team
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Policy Version Tracking
model PolicyVersion {
  id            Int      @id @default(autoincrement())
  version       String // e.g., "v2.1"
  changes       Json // Description of changes
  changedBy     Int // User who made changes
  effectiveFrom DateTime // When this version takes effect
  createdAt     DateTime @default(now())

  changedByUser User @relation(fields: [changedBy], references: [id])

  @@index([effectiveFrom])
}

// Enhanced User Profile Models

model UserProfile {
  id               Int       @id @default(autoincrement())
  userId           Int       @unique
  phone            String?
  address          String?   @db.Text
  permanentAddress String?   @db.Text
  dob              DateTime?
  gender           String?
  bloodGroup       String?
  maritalStatus    String?
  nid              String?
  tin              String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  relation  String
  phone     String
  address   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BankDetails {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  bankName      String
  accountNumber String
  branchName    String?
  routingNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDocument {
  id         Int      @id @default(autoincrement())
  userId     Int
  title      String
  type       String // e.g., "NID", "Passport", "Certificate"
  fileUrl    String
  uploadedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Scheduled Reports System
model ScheduledReport {
  id           Int             @id @default(autoincrement())
  name         String // Report name (e.g., "Monthly Leave Summary")
  reportType   ReportType // Type of report
  format       ReportFormat // Output format (PDF, Excel, CSV)
  frequency    ReportFrequency // How often to generate
  recipients   Json // Array of email addresses
  filters      Json? // Report filters (department, date range, etc.)
  scheduleTime String? // Cron expression or time (e.g., "09:00")
  scheduleDay  Int? // Day of month (1-31) or week (1-7)
  isActive     Boolean         @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdBy    Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  creator    User              @relation("ReportCreator", fields: [createdBy], references: [id])
  executions ReportExecution[]

  @@index([createdBy])
  @@index([isActive, nextRunAt])
  @@index([reportType, isActive])
}

// Report Execution History
model ReportExecution {
  id          Int             @id @default(autoincrement())
  reportId    Int
  status      ExecutionStatus @default(PENDING)
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  fileUrl     String? // Generated file path
  fileSize    Int? // File size in bytes
  recordCount Int? // Number of records in report
  errorLog    String?         @db.Text
  sentTo      Json? // Emails successfully sent to

  report ScheduledReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, status])
  @@index([startedAt])
}

// Calendar Integration - User's calendar configurations
model CalendarConfig {
  id                Int              @id @default(autoincrement())
  userId            Int
  provider          CalendarProvider
  providerAccountId String // External account ID (email, etc.)
  accessToken       String           @db.Text // Encrypted access token
  refreshToken      String           @db.Text // Encrypted refresh token
  tokenExpiry       DateTime
  calendarId        String? // Specific calendar ID to sync to
  isActive          Boolean          @default(true)
  lastSyncAt        DateTime?
  syncErrors        Json? // Array of error messages
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mappings LeaveCalendarMapping[]

  @@unique([userId, provider])
  @@index([userId, isActive])
  @@index([provider])
}

// Calendar Integration - Leave to Calendar event mapping
model LeaveCalendarMapping {
  id               Int      @id @default(autoincrement())
  leaveId          Int
  calendarConfigId Int
  externalEventId  String // Event ID in external calendar
  lastSyncedAt     DateTime @default(now())
  syncStatus       String   @default("synced") // "synced", "pending", "failed", "deleted"
  errorMessage     String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  leave          LeaveRequest   @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  calendarConfig CalendarConfig @relation(fields: [calendarConfigId], references: [id], onDelete: Cascade)

  @@unique([leaveId, calendarConfigId])
  @@index([leaveId])
  @@index([calendarConfigId])
  @@index([syncStatus])
}

// Webhook System for External Integrations
model Webhook {
  id          Int      @id @default(autoincrement())
  name        String
  url         String   @db.Text
  events      Json     // Array of event types: ["leave.submitted", "leave.approved", etc.]
  secret      String   @db.Text // HMAC secret for signature verification
  enabled     Boolean  @default(true)

  // Metadata
  description String?  @db.Text
  headers     Json?    // Custom headers to include in webhook requests

  // Status tracking
  lastTriggeredAt DateTime?
  failureCount    Int      @default(0)
  lastFailureAt   DateTime?

  // Audit
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  creator     User              @relation(fields: [createdBy], references: [id])
  deliveries  WebhookDelivery[]

  @@index([enabled])
  @@index([createdBy])
  @@index([lastTriggeredAt])
}

model WebhookDelivery {
  id          Int      @id @default(autoincrement())
  webhookId   Int
  event       String   // Event type that triggered this delivery
  payload     Json     // Event payload

  // Request details
  requestUrl      String   @db.Text
  requestHeaders  Json?
  requestBody     Json

  // Response details
  responseStatus  Int?
  responseHeaders Json?
  responseBody    String?  @db.Text

  // Delivery status
  status      String   // "pending", "success", "failed", "retrying"
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)

  // Error tracking
  errorMessage String?  @db.Text
  errorCode    String?

  // Timing
  deliveredAt DateTime?
  nextRetryAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([event])
  @@index([status])
  @@index([createdAt])
  @@index([nextRetryAt])
}
